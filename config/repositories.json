      "windowsFallback": "G:\\TechStudyNotes\\LLDProjects",
      "required": true,
      "profileScan": true
    },
    {
      "name": "HLD",
      "environmentVariable": "MOCK_HLD_ROOT",
      "relativeToPracticeParent": "SystemDesignProjects",
      "windowsFallback": "G:\\TechStudyNotes\\SystemDesignProjects",
      "required": true,
      "profileScan": true
    },
    {
      "name": "MOCK_HISTORY",
