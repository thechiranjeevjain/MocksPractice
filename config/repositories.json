  "defaultExtensions": [".md", ".java", ".json", ".xml", ".yml", ".yaml", ".sql", ".properties", ".ps1", ".cmd", ".sh"],
  "excludedDirectoryNames": [".git", ".idea", "target", "build", "out", "node_modules", ".m2repo", "_archive", "coverage", "dist"]
