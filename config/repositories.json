{
  "schemaVersion": 1,
  "repositories": [
    {
      "name": "DSA",
      "environmentVariable": "MOCK_DSA_ROOT",
      "relativeToPracticeParent": "Codes/DSA10days",
      "windowsFallback": "G:\\TechStudyNotes\\Codes\\DSA10days",
      "required": true,
      "profileScan": true
    },
    {
      "name": "LLD",
      "environmentVariable": "MOCK_LLD_ROOT",
